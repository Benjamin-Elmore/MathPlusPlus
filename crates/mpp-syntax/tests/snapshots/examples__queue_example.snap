g \equiv 9.81
  => (def ≡ g 9.81)
v_0 := 20
  => (def := (initial v 0) 20)
\theta, R(\theta)
  => (names θ (call R θ))
y(x) := x \tan\theta - \frac{g x^2}{2 v_0^2 \cos^2\theta}
  => (def := (fn-head y x) (- (* :implicit x (tan θ)) (/ :frac (* :implicit g (^ x 2)) (* :implicit (* :implicit 2 (^ (_ v 0) 2)) (^ (cos θ) 2)))))
E := \tfrac12 m v_0^2
  => (def := E (* :implicit (* :implicit (/ :tfrac 1 2) m) (^ (_ v 0) 2)))
\frac{d}{dx} y(x) = ?
  => (query =? (deriv :op-frac (by x) (call y x)))
\int_0^{R} y(x)\,dx \approx ?
  => (query ≈? (int :lower 0 :upper R (call y x) (d x)))
\sum_{n=1}^{\infty} \frac{1}{n^2} = ?
  => (query =? (sum :index n :from 1 :to #inf (/ :frac 1 (^ n 2))))
\lim_{x\to 0} \frac{\sin x}{x} = ?
  => (query =? (lim x 0 (/ :frac (sin x) x)))
y(x)
  => (call y x)
x \in [0, R]
  => (range (x) (interval [] 0 R))
z = x^2 - y^2
  => (rel z = (- (^ x 2) (^ y 2)))
x, y \in [-2, 2]
  => (range (x y) (interval [] (neg 2) 2))
